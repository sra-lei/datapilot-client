# 开发环境配置
VITE_APP_TITLE=Trae Management
VITE_APP_VERSION=1.0.0

# 主服务器配置（Node.js Server）
VITE_SERVER_MAIN_HOST=localhost
VITE_SERVER_MAIN_PORT=3002
VITE_SERVER_MAIN_URL=http://localhost:3002

# 业务服务器配置（Python Server）
VITE_SERVER_BUSINESS_HOST=localhost
VITE_SERVER_BUSINESS_PORT=8000
VITE_SERVER_BUSINESS_URL=http://localhost:8000

# API 路径前缀
VITE_API_PREFIX=/api

# 是否启用 Mock 数据
VITE_ENABLE_MOCK=false