# 开发环境配置
VITE_APP_TITLE=Trae Management
VITE_APP_VERSION=1.0.0

# 主服务器配置（Node.js Server）
VITE_SERVER_MAIN_HOST=localhost
VITE_SERVER_MAIN_PORT=3002
VITE_SERVER_MAIN_URL=http://localhost:3002

# 业务服务器配置（Python Server，旧 CharterMate）
VITE_SERVER_BUSINESS_HOST=localhost
VITE_SERVER_BUSINESS_PORT=8000
VITE_SERVER_BUSINESS_URL=http://localhost:8000

# Docs-Seeker 服务配置（RAG 检索问答，Python FastAPI）
VITE_SERVER_DOCS_SEEKER_HOST=localhost
VITE_SERVER_DOCS_SEEKER_PORT=8001
VITE_SERVER_DOCS_SEEKER_URL=http://localhost:8001

# Doc-Kit 服务配置（文档解析 / 向量入库）
VITE_SERVER_DOC_KIT_HOST=localhost
VITE_SERVER_DOC_KIT_PORT=8100
VITE_SERVER_DOC_KIT_URL=http://localhost:8100

# API 路径前缀
VITE_API_PREFIX=/api

# 是否启用 Mock 数据
VITE_ENABLE_MOCK=false